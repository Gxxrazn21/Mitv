# MiTV Studio - Production Environment Variables Configuration
# Copy this file to .env and adjust for your production server (e.g., Oracle Cloud)

# Port to bind the HTTP server
PORT=7860

# Host to bind the HTTP server (use 0.0.0.0 for external access in cloud VMs)
BIND_HOST=0.0.0.0

# Node environment
NODE_ENV=production

# Cache duration for scraped matches and channels in milliseconds (default: 3 minutes)
CACHE_TTL_MS=180000
